# Backend local environment example.
# Copy this file to backend/.env for local Django commands.
# Do not commit real secrets or production database credentials.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_ENGINE=django.db.backends.postgresql
DB_NAME=book_lens
DB_USER=book_lens_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

GOOGLE_API_KEY=
SUPABASE_URL=
SUPABASE_BUCKET=character-images

BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_M3_BATCH_SIZE=12
BGE_M3_MAX_LENGTH=8192
BGE_M3_USE_FP16=false
BGE_M3_PRELOAD=import
BGE_M3_DEVICE=cpu
