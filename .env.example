# Docker Compose root environment example.
# Copy this file to .env only when running docker compose from the repository root.
# Do not commit real secrets or production database credentials.

SERVER_API_URL=http://django:8000
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost

DB_ENGINE=django.db.backends.postgresql
DB_NAME=book_lens
DB_USER=book_lens_user
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

GOOGLE_API_KEY=
SUPABASE_URL=
SUPABASE_BUCKET=character-images
