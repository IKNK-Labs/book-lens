# Frontend local environment example.
# Copy this file to frontend/.env.local for local Next.js commands.
# Only public Supabase client config belongs here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SERVER_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
ENABLE_MOCK_AUTH_PREVIEW=false
