{
  "info": {
    "name": "BookLens Chat Session MVP",
    "description": "Manual smoke tests for the BookLens chat session backend MVP. Fill the example environment with dev-only test values before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Greeting",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/chat/greeting?character_id={{character_id}}&user_id={{user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat",
            "greeting"
          ],
          "query": [
            {
              "key": "character_id",
              "value": "{{character_id}}"
            },
            {
              "key": "user_id",
              "value": "{{user_id}}"
            }
          ]
        },
        "description": "Returns a display-only greeting. Verify this does not create a conversation_log row."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test(\"greeting exists\", function () {",
              "  pm.expect(json.greeting).to.exist;",
              "});",
              "pm.test(\"assistant_log_id exists\", function () {",
              "  pm.expect(json).to.have.property(\"assistant_log_id\");",
              "});",
              "pm.test(\"has_history exists\", function () {",
              "  pm.expect(json).to.have.property(\"has_history\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Or Get Chat Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"character_id\": \"{{character_id}}\",\n  \"user_id\": \"{{user_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/chat/sessions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat",
            "sessions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200 or 201\", function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test(\"session id exists\", function () {",
              "  pm.expect(json.id).to.exist;",
              "});",
              "",
              "if (json.id) {",
              "  pm.environment.set(\"session_id\", json.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List Chat Sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/chat/sessions?user_id={{user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat",
            "sessions"
          ],
          "query": [
            {
              "key": "user_id",
              "value": "{{user_id}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"response is an array\", function () {",
              "  pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Chat Session Messages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/chat/sessions/{{session_id}}/messages?user_id={{user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat",
            "sessions",
            "{{session_id}}",
            "messages"
          ],
          "query": [
            {
              "key": "user_id",
              "value": "{{user_id}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"response is an array\", function () {",
              "  pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Send Chat Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"character_id\": \"{{character_id}}\",\n  \"user_id\": \"{{user_id}}\",\n  \"message\": \"안녕\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/chat",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test(\"chat response fields exist\", function () {",
              "  pm.expect(json.response).to.exist;",
              "  pm.expect(json.assistant_log_id).to.exist;",
              "  pm.expect(json.session_id).to.exist;",
              "});",
              "",
              "if (json.session_id) {",
              "  pm.environment.set(\"session_id\", json.session_id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Chat Session",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/chat/sessions/{{session_id}}?user_id={{user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat",
            "sessions",
            "{{session_id}}"
          ],
          "query": [
            {
              "key": "user_id",
              "value": "{{user_id}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 204\", function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
